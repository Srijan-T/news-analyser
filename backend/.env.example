# Copy to backend/.env and fill in. Never commit backend/.env.

# "development" locally, "production" on Railway
APP_ENV=development

# News source: "fake" replays a saved response (no API quota used; good for dev),
# "gnews" calls https://gnews.io (free plan: 100 requests/day, ~12h delay).
NEWS_PROVIDER=fake
GNEWS_API_KEY=
# New (non-cached) searches allowed per UTC day; GNews free is 100/day.
NEWS_DAILY_REQUEST_LIMIT=95

# Sign-in for the deployed app: one shared password. Leave both blank locally (no sign-in).
# SESSION_SECRET signs the session cookie: a long random string, e.g. `openssl rand -hex 32`.
APP_PASSWORD=
SESSION_SECRET=

# Path to the built frontend. Set automatically in the Docker image; leave blank locally
# (Vite serves the frontend in dev).
STATIC_DIR=

# Postgres. Default: the docker-compose database (`make db`, port 5433). Railway sets this.
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/news_analyser

# AI analysis: "fake" analyzes offline (no tokens); "openai" uses OPENAI_API_KEY.
ANALYZER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
